# GitHub App 자격증명 (필수)
GITHUB_APP_ID=

# 개인키는 파일 경로로 주는 쪽을 권장한다 — PEM은 여러 줄이라 환경변수로 넘기면
# systemd EnvironmentFile 등에서 개행 이스케이프가 깨진다.
# GitHub이 주는 PKCS#1(.pem)을 그대로 두면 되고, 코드가 PKCS#8로 변환해 사용한다.
GITHUB_PRIVATE_KEY_PATH=/path/to/github-app.pem
# (대안) 한 줄 문자열로 넣을 경우 개행을 \n 으로 이스케이프
# GITHUB_PRIVATE_KEY=

# 서버 포트 (기본 3001 — 3000은 대시보드 개발 서버가 사용)
PORT=3001

# 대시보드 도메인. 이 origin의 브라우저 요청만 허용한다
CORS_ORIGIN=http://localhost:3000

# 카탈로그(.claude/, .agents/, .codex/) 루트. 생략하면 저장소 루트를 자동 계산
CATALOG_ROOT=
